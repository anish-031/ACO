# Copy these names to ~/.folk/acobot/.env and fill in your own values.
# Never share or commit your populated .env file.
ACO_BOT_TOKEN=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
ETHERSCAN_API_KEY=
ETHEREUM_BLOCKSCOUT_API_URL=
ROBINHOOD_BLOCKSCOUT_API_URL=
INK_BLOCKSCOUT_API_URL=
ETHEREUM_RPC_URL=
ETHEREUM_RPC_BACKUP_URLS=
ROBINHOOD_RPC_URL=
ROBINHOOD_RPC_BACKUP_URLS=
INK_RPC_URL=
INK_RPC_BACKUP_URLS=
SOLANA_RPC_URL=
SOLANA_RPC_BACKUP_URLS=
# Optional. When unset, the bot requests OpenSea's free 7-day agent key
# from POST https://api.opensea.io/api/v2/auth/keys. A saved key is used first.
OPENSEA_API_KEY=
# Optional. Reservoir's api.reservoir.tools host no longer resolves.
# Magic Eden's public Solana collections API does not need a key.
# Etherscan is optional: Ethereum ABIs fall back to Routescan and eth.blockscout.com.
RESERVOIR_API_KEY=
MAGICEDEN_API_KEY=
